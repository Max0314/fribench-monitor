cpl ALL=(root) NOPASSWD: \
    /usr/bin/docker compose -f /srv/fribench/apps/internal/fribench-monitor/current/compose.yaml config, \
    /usr/bin/docker compose -f /srv/fribench/apps/internal/fribench-monitor/current/compose.yaml build, \
    /usr/bin/docker compose -f /srv/fribench/apps/internal/fribench-monitor/current/compose.yaml up -d, \
    /usr/bin/docker compose -f /srv/fribench/apps/internal/fribench-monitor/current/compose.yaml ps, \
    /usr/bin/docker compose -f /srv/fribench/apps/internal/fribench-monitor/current/compose.yaml logs --tail=200, \
    /usr/bin/docker compose -f /srv/fribench/apps/internal/fribench-monitor/current/compose.yaml restart, \
    /usr/bin/docker compose -f /srv/fribench/apps/internal/fribench-monitor/current/compose.yaml down
